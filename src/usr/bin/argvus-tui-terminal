#!/usr/bin/env sh
# Launch ARGVUS-owned TUI windows with a dedicated font profile.

set -eu

ARGVUS_BOOTSTRAP="${ARGVUS_BOOTSTRAP:-${ARGVUS_SYSTEM_CONFIG:-/usr/share/argvus}/session/sh/bootstrap.sh}"
# shellcheck disable=SC1090,SC1091
. "$ARGVUS_BOOTSTRAP"
# shellcheck disable=SC1091
. /usr/share/argvus/lib/i18n.sh

_class="argvus-tui"
_term_override=""
_terminal_profile="default"
_materialize_kitty=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --materialize-kitty)
      _materialize_kitty=1
      shift
      ;;
    --class)
      [ "$#" -ge 2 ] || {
        printf '%s\n' "$(argvus_tr app-profiles launcher.class_requires_value)" >&2
        exit 1
      }
      _class="$2"
      shift 2
      ;;
    --class=*)
      _class="${1#--class=}"
      shift
      ;;
    --term|--terminal)
      [ "$#" -ge 2 ] || {
        printf '%s\n' "$(argvus_tr app-profiles launcher.option_requires_value option="$1")" >&2
        exit 1
      }
      _term_override="$2"
      shift 2
      ;;
    --term=*|--terminal=*)
      _term_override="${1#*=}"
      shift
      ;;
    --profile)
      [ "$#" -ge 2 ] || {
        printf '%s\n' "$(argvus_tr app-profiles launcher.option_requires_value option="$1")" >&2
        exit 1
      }
      _terminal_profile="$2"
      shift 2
      ;;
    --profile=*)
      _terminal_profile="${1#--profile=}"
      shift
      ;;
    --)
      shift
      break
      ;;
    *) break ;;
  esac
done

_font_profile="terminal"
_file_manager_profile=0
case "$_class" in
  argvus-file-manager|*superfile*|*yazi*|*spf*)
    _font_profile="apps"
    _file_manager_profile=1
    ;;
esac
for _arg do
  case "$_arg" in
    --spf|spf|--superfile|superfile|--yazy|yazy|--yazi|yazi)
      _font_profile="apps"
      _file_manager_profile=1
      break
      ;;
  esac
done

font_state_value() {
  _key="$1"
  _fallback="$2"
  _fonts_file="${ARGVUS_CONFIG_HOME}/argvus/data/generated/fonts.conf"
  if [ -f "$_fonts_file" ]; then
    _value="$(sed -n "s|^${_key}=||p" "$_fonts_file" | head -n1)"
    [ -n "$_value" ] && { printf '%s\n' "$_value"; return 0; }
  fi
  printf '%s\n' "$_fallback"
}

font_family() {
  case "$_font_profile" in
    apps) font_state_value apps_family "$(font_state_value default_family "IBM Plex Mono")" ;;
    *) font_state_value terminal_family "$(font_state_value monospace_family "IBM Plex Mono")" ;;
  esac
}

font_size() {
  case "$_font_profile" in
    apps)
      if [ "$_file_manager_profile" -eq 1 ]; then
        font_state_value terminal_size "$(font_state_value monospace_size 13)"
      else
        font_state_value apps_size "$(font_state_value default_size 12)"
      fi
      ;;
    *) font_state_value terminal_size "$(font_state_value monospace_size 13)" ;;
  esac
}

# Computes the Kitty background_opacity for the ARGVUS Control Center profile.
# Transparency only takes effect when both the transparency and blur effects are
# enabled; disabling either restores a fully opaque window.
control_center_background_opacity() {
  _transparency_enabled="true"
  _transparency_value="50"
  _blur_enabled="true"
  if command -v argvus-config >/dev/null 2>&1; then
    _transparency_enabled="$(argvus-config get /effects/transparency_control-center_enabled --effective --raw 2>/dev/null || true)"
    _transparency_value="$(argvus-config get /effects/transparency_control-center_value --effective --raw 2>/dev/null || true)"
    _blur_enabled="$(argvus-config get /effects/blur_control-center_enabled --effective --raw 2>/dev/null || true)"
  fi
  case "$_transparency_enabled" in
    true) _transparency_on=1 ;;
    *) _transparency_on=0 ;;
  esac
  case "$_blur_enabled" in
    true) _blur_on=1 ;;
    *) _blur_on=0 ;;
  esac
  if [ "$_transparency_on" -eq 1 ] && [ "$_blur_on" -eq 1 ]; then
    case "$_transparency_value" in
      ''|*[!0-9]*) _transparency_value=50 ;;
    esac
    [ "$_transparency_value" -le 100 ] || _transparency_value=50
    awk -v value="$_transparency_value" 'BEGIN { printf "%.2f\n", 1 - (value / 100) }'
  else
    printf '1.00\n'
  fi
}

runtime_kitty_config() {
  case "$_terminal_profile" in
    greeter|control-center)
      if command -v argvus-terminal >/dev/null 2>&1; then
        # Materialize the active theme and user font settings before applying
        # the policy below (Greeter or Control Center windows).
        _src="$(argvus-terminal --print-tui-config)"
      else
        _src="$(paths_cache "argvus-terminal/kitty-tui-apps.conf")"
        [ -f "$_src" ] || _src="$(paths_config "terminal/config/kitty-tui/kitty.conf")"
      fi
      ;;
    *)
      _src="$(paths_cache "argvus-terminal/kitty-tui-apps.conf")"
      [ -f "$_src" ] || _src="$(paths_config "terminal/config/kitty-tui/kitty.conf")"
      ;;
  esac
  case "$_terminal_profile" in
    greeter) _dst="$(paths_cache "kitty-tui/kitty-greeter.conf")" ;;
    control-center) _dst="$(paths_cache "kitty-tui/kitty-control-center.conf")" ;;
    *)
      if [ "$_file_manager_profile" -eq 1 ]; then
        _dst="$(paths_cache "kitty-tui/kitty-file-manager.conf")"
      else
        _dst="$(paths_cache "kitty-tui/kitty-${_font_profile}.conf")"
      fi
      ;;
  esac
  _family="$(font_family)"
  _size="$(font_size)"
  mkdir -p "${_dst%/*}"
  awk -v family="$_family" -v size="$_size" '
    /^[[:space:]]*font_family[[:space:]]+/ { print "font_family      " family; next }
    /^[[:space:]]*font_size[[:space:]]+/ { print "font_size        " size; next }
    { print }
  ' "$_src" > "$_dst"
  case "$_terminal_profile" in
    greeter)
      cat >> "$_dst" <<'EOF'

# ARGVUS Greeter policy: this is a runtime-only override. The regular Kitty
# configuration and all user terminal sessions keep their tab behavior.
tab_bar_style hidden
map ctrl+alt+n no_op
map ctrl+shift+t no_op
map ctrl+q no_op
map alt+1 no_op
map alt+2 no_op
map alt+3 no_op
map alt+4 no_op
map alt+5 no_op
map ctrl+tab no_op
map ctrl+shift+tab no_op
EOF
      ;;
    control-center)
      # ARGVUS Control Center policy: tab-less window with the transparency
      # requested for the Control Center TUI. The opacity is appended after the
      # base configuration so it always wins.
      _opacity="$(control_center_background_opacity)"
      printf '\n# ARGVUS Control Center policy: this is a runtime-only override. The\n# regular Kitty configuration and all user terminal sessions keep their tab\n# behavior and transparency.\nbackground_opacity %s\ntab_bar_style hidden\nmap ctrl+alt+n no_op\nmap ctrl+shift+t no_op\nmap ctrl+q no_op\nmap alt+1 no_op\nmap alt+2 no_op\nmap alt+3 no_op\nmap alt+4 no_op\nmap alt+5 no_op\nmap ctrl+tab no_op\nmap ctrl+shift+tab no_op\n' "$_opacity" >> "$_dst"
      ;;
  esac
  printf '%s\n' "$_dst"
}

# Regenerate the Kitty profile for the requested window without launching any
# terminal. This gives the session scripts a hook to rematerialize the Control
# Center backing store after effect changes.
if [ "$_materialize_kitty" -eq 1 ]; then
  runtime_kitty_config >/dev/null
  exit 0
fi

_backend="${_term_override:-kitty}"
case "$_backend" in
  argvus-terminal)
    exec argvus-terminal \
      --class "$_class" \
      --font-profile "$_font_profile" \
      --tui \
      -e "$@"
    ;;
  kitty)
    _kitty_config="$(runtime_kitty_config)"
    exec kitty \
      --class "$_class" \
      --config "$_kitty_config" \
      -e "$@"
    ;;
  alacritty)
    exec alacritty --class "$_class" -e "$@"
    ;;
  *)
    exec "$_backend" -e "$@"
    ;;
esac
