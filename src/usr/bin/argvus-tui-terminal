#!/usr/bin/env sh
# Launch ARGVUS-owned TUI windows with a dedicated font profile.

set -eu

ARGVUS_BOOTSTRAP="${ARGVUS_BOOTSTRAP:-${ARGVUS_SYSTEM_CONFIG:-/usr/share/argvus}/session/sh/bootstrap.sh}"
# shellcheck disable=SC1090,SC1091
. "$ARGVUS_BOOTSTRAP"
# shellcheck disable=SC1091
. /usr/share/argvus/lib/i18n.sh

_class="argvus-tui"
_term_override=""
_terminal_profile="default"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --class)
      [ "$#" -ge 2 ] || {
        printf '%s\n' "$(argvus_tr app-profiles launcher.class_requires_value)" >&2
        exit 1
      }
      _class="$2"
      shift 2
      ;;
    --class=*)
      _class="${1#--class=}"
      shift
      ;;
    --term|--terminal)
      [ "$#" -ge 2 ] || {
        printf '%s\n' "$(argvus_tr app-profiles launcher.option_requires_value option="$1")" >&2
        exit 1
      }
      _term_override="$2"
      shift 2
      ;;
    --term=*|--terminal=*)
      _term_override="${1#*=}"
      shift
      ;;
    --profile)
      [ "$#" -ge 2 ] || {
        printf '%s\n' "$(argvus_tr app-profiles launcher.option_requires_value option="$1")" >&2
        exit 1
      }
      _terminal_profile="$2"
      shift 2
      ;;
    --profile=*)
      _terminal_profile="${1#--profile=}"
      shift
      ;;
    --)
      shift
      break
      ;;
    *) break ;;
  esac
done

_font_profile="terminal"
_file_manager_profile=0
case "$_class" in
  argvus-file-manager|*superfile*|*yazi*|*spf*)
    _font_profile="apps"
    _file_manager_profile=1
    ;;
esac
for _arg do
  case "$_arg" in
    --spf|spf|--superfile|superfile|--yazy|yazy|--yazi|yazi)
      _font_profile="apps"
      _file_manager_profile=1
      break
      ;;
  esac
done

font_state_value() {
  _key="$1"
  _fallback="$2"
  _fonts_file="${ARGVUS_CONFIG_HOME}/argvus/fonts.conf"
  if [ -f "$_fonts_file" ]; then
    _value="$(sed -n "s|^${_key}=||p" "$_fonts_file" | head -n1)"
    [ -n "$_value" ] && { printf '%s\n' "$_value"; return 0; }
  fi
  printf '%s\n' "$_fallback"
}

font_family() {
  case "$_font_profile" in
    apps) font_state_value apps_family "$(font_state_value default_family "IBM Plex Mono")" ;;
    *) font_state_value terminal_family "$(font_state_value monospace_family "IBM Plex Mono")" ;;
  esac
}

font_size() {
  case "$_font_profile" in
    apps)
      if [ "$_file_manager_profile" -eq 1 ]; then
        font_state_value terminal_size "$(font_state_value monospace_size 13)"
      else
        font_state_value apps_size "$(font_state_value default_size 12)"
      fi
      ;;
    *) font_state_value terminal_size "$(font_state_value monospace_size 13)" ;;
  esac
}

runtime_foot_config() {
  _src="$(paths_config "app-profiles/config/foot-tui/foot.ini")"
  _dst="$(paths_cache "foot-tui/foot.ini")"
  _family="$(font_family)"
  _size="$(font_size)"
  mkdir -p "${_dst%/*}"
  awk -v family="$_family" -v size="$_size" '
    /^[[:space:]]*font=/ { print "font=" family ":size=" size ", Noto Color Emoji:size=12"; next }
    { print }
  ' "$_src" > "$_dst"
  printf '%s\n' "$_dst"
}

runtime_kitty_config() {
  if [ "$_terminal_profile" = "greeter" ] && command -v argvus-terminal >/dev/null 2>&1; then
    # Materialize the active theme and user font settings before applying
    # the Greeter-only Kitty policy below.
    _src="$(argvus-terminal --print-tui-config)"
  else
    _src="$(paths_cache "argvus-terminal/kitty-tui-apps.conf")"
    [ -f "$_src" ] || _src="$(paths_config "terminal/config/kitty-tui/kitty.conf")"
  fi
  if [ "$_terminal_profile" = "greeter" ]; then
    _dst="$(paths_cache "kitty-tui/kitty-greeter.conf")"
  elif [ "$_file_manager_profile" -eq 1 ]; then
    _dst="$(paths_cache "kitty-tui/kitty-file-manager.conf")"
  else
    _dst="$(paths_cache "kitty-tui/kitty-${_font_profile}.conf")"
  fi
  _family="$(font_family)"
  _size="$(font_size)"
  mkdir -p "${_dst%/*}"
  awk -v family="$_family" -v size="$_size" '
    /^[[:space:]]*font_family[[:space:]]+/ { print "font_family      " family; next }
    /^[[:space:]]*font_size[[:space:]]+/ { print "font_size        " size; next }
    { print }
  ' "$_src" > "$_dst"
  if [ "$_terminal_profile" = "greeter" ]; then
    cat >> "$_dst" <<'EOF'

# ARGVUS Greeter policy: this is a runtime-only override. The regular Kitty
# configuration and all user terminal sessions keep their tab behavior.
tab_bar_style hidden
map ctrl+alt+n no_op
map ctrl+shift+t no_op
map ctrl+q no_op
map alt+1 no_op
map alt+2 no_op
map alt+3 no_op
map alt+4 no_op
map alt+5 no_op
map ctrl+tab no_op
map ctrl+shift+tab no_op
EOF
  fi
  printf '%s\n' "$_dst"
}

_backend="${_term_override:-${TERM##*/}}"
case "$_backend" in
  argvus-terminal)
    exec argvus-terminal \
      --class "$_class" \
      --font-profile "$_font_profile" \
      --tui \
      -e "$@"
    ;;
  kitty)
    _kitty_config="$(runtime_kitty_config)"
    exec kitty \
      --class "$_class" \
      --config "$_kitty_config" \
      -e "$@"
    ;;
  foot|footclient)
    exec "$_backend" \
      --app-id "$_class" \
      -c "$(runtime_foot_config)" \
      -e "$@"
    ;;
  alacritty)
    exec alacritty --class "$_class" -e "$@"
    ;;
  *)
    exec "$_backend" -e "$@"
    ;;
esac
