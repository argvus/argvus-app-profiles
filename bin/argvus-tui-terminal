#!/usr/bin/env sh
# Launch ARGVUS-owned TUI windows with a dedicated font profile.

set -eu

ARGVUS_BOOTSTRAP="${ARGVUS_BOOTSTRAP:-${ARGVUS_SYSTEM_CONFIG:-/usr/share/argvus}/scripts/argvus/bootstrap.sh}"
# shellcheck disable=SC1090,SC1091
. "$ARGVUS_BOOTSTRAP"

_class="argvus-tui"

case "${1:-}" in
  --class)
    [ "$#" -ge 2 ] || {
      printf 'argvus-tui-terminal: --class requires a value\n' >&2
      exit 1
    }
    _class="$2"
    shift 2
    ;;
  --class=*)
    _class="${1#--class=}"
    shift
    ;;
esac

if [ "${1:-}" = "--" ]; then
  shift
fi

font_state_value() {
  _key="$1"
  _fallback="$2"
  _fonts_file="${ARGVUS_CONFIG_HOME}/argvus/fonts.conf"
  if [ -f "$_fonts_file" ]; then
    _value="$(sed -n "s|^${_key}=||p" "$_fonts_file" | head -n1)"
    [ -n "$_value" ] && { printf '%s\n' "$_value"; return 0; }
  fi
  printf '%s\n' "$_fallback"
}

runtime_kitty_config() {
  _src="$(paths_config "kitty-tui/kitty.conf")"
  _dst="$(paths_cache "kitty-tui/kitty.conf")"
  _family="$(font_state_value monospace_family "Terminus (TTF)")"
  _size="$(font_state_value monospace_size 13)"
  mkdir -p "${_dst%/*}"
  awk -v family="$_family" -v size="$_size.0" '
    /^[[:space:]]*font_family[[:space:]]+/ { print "font_family      " family; next }
    /^[[:space:]]*font_size[[:space:]]+/ { print "font_size        " size; next }
    { print }
  ' "$_src" > "$_dst"
  printf '%s\n' "$_dst"
}

runtime_foot_config() {
  _src="$(paths_config "foot-tui/foot.ini")"
  _dst="$(paths_cache "foot-tui/foot.ini")"
  _family="$(font_state_value monospace_family "Terminus (TTF)")"
  _size="$(font_state_value monospace_size 14)"
  mkdir -p "${_dst%/*}"
  awk -v family="$_family" -v size="$_size" '
    /^[[:space:]]*font=/ { print "font=" family ":size=" size ", Noto Color Emoji:size=12"; next }
    { print }
  ' "$_src" > "$_dst"
  printf '%s\n' "$_dst"
}

case "${TERM##*/}" in
  kitty)
    exec kitty \
      --class "$_class" \
      --config "$(runtime_kitty_config)" \
      -e "$@"
    ;;
  foot|footclient)
    exec "$TERM" \
      --app-id "$_class" \
      -c "$(runtime_foot_config)" \
      -e "$@"
    ;;
  alacritty)
    exec alacritty --class "$_class" -e "$@"
    ;;
  *)
    exec "$TERM" -e "$@"
    ;;
esac
