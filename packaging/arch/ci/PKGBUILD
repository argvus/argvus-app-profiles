pkgname=argvus-app-profiles
pkgver=0.1.0
pkgrel=1
pkgdesc="Application profiles and launcher wrappers for the ARGVUS desktop"
arch=('any')
url="https://github.com/argvus/argvus-app-profiles"
license=('GPL-3.0-only')
depends=('argvus-snappy-switcher' 'argvus-session' 'argvus-system-monitor' 'argvus-i18n' 'jq' 'argvus-terminal' 'superfile' 'yazi')
optdepends=('argvus-control-center: control center launched by argvus --control-center and argvus --about' 'argvus-taskbar-calendar: calendar app launched by argvus --calendar' 'argvus-removable-devices: removable storage app launched by argvus --removable-devices' 'neovim: default terminal editor profile' 'vivid: LS_COLORS generation in the shared terminal profile')
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=()

# shellcheck disable=SC1091
_functions_file="${startdir:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}/../common/functions.sh"
. "$_functions_file"

prepare() { arch_normalize_source_tree; }
check() { arch_check_app_profiles_payload; }
package() { arch_package_app_profiles_payload; }
