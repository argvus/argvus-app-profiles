# Maintainer: William C. Canin
pkgname=argvus-app-profiles
pkgver=0.1.0
pkgrel=1
pkgdesc="Application profiles and launcher wrappers for the ARGVUS desktop"
arch=('x86_64')
url="https://github.com/argvus/argvus-app-profiles"
license=('GPL-3.0-only')
depends=('argvus-snappy-switcher' 'argvus-session' 'argvus-system-monitor' 'argvus-i18n' 'jq' 'argvus-terminal' 'superfile' 'yazi' 'gcc-libs' 'glibc')
optdepends=('argvus-control-center: control center launched by argvus --control-center and argvus --about' 'argvus-taskbar-calendar: calendar app launched by argvus --calendar' 'argvus-removable-devices: removable storage app launched by argvus --removable-devices' 'neovim: default terminal editor profile' 'vivid: LS_COLORS generation in the shared terminal profile')
makedepends=('cargo')
options=('!debug')
source=(
  "${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
)
sha256sums=()

_source_dir() {
  find "${srcdir}" -mindepth 1 -maxdepth 1 -type d -print -quit
}

_cargo_target_dir() {
  printf '%s\n' "${CARGO_TARGET_DIR:-"${srcdir}/target"}"
}

build() {
  cd "$(_source_dir)"
  local cargo_target_dir
  cargo_target_dir="$(_cargo_target_dir)"
  export CARGO_TARGET_DIR="$cargo_target_dir"
  cargo build --workspace --release --locked
}

check() {
  cd "$(_source_dir)"
  local cargo_target_dir
  cargo_target_dir="$(_cargo_target_dir)"
  export CARGO_TARGET_DIR="$cargo_target_dir"
  cargo test --workspace --release --locked
  local script
  while IFS= read -r -d '' script; do sh -n "$script"; done < <(find src -type f -name '*.sh' -print0)
  test -x "${cargo_target_dir}/release/argvus-tui-terminal"
}

package() {
  cd "$(_source_dir)"
  local cargo_target_dir
  cargo_target_dir="$(_cargo_target_dir)"

  install -Dm755 "${cargo_target_dir}/release/argvus-tui-terminal" "${pkgdir}/usr/lib/argvus/commands/argvus-tui-terminal"
  install -Dm755 "src/usr/share/argvus/app-profiles/sh/yazi-keymap.sh" "${pkgdir}/usr/lib/argvus/commands/argvus-app-profiles-yazi-keymap"
  install -dm755 "${pkgdir}/usr/share/argvus/app-profiles"
  cp -R --no-preserve=ownership "src/usr/share/argvus/app-profiles/." "${pkgdir}/usr/share/argvus/app-profiles/"
  # snappy-switcher does not consume the ARGVUS app-profiles tree directly.
  # Its native loader searches flat <name>.ini files in this system directory.
  install -dm755 "${pkgdir}/usr/share/snappy-switcher/themes"
  while IFS= read -r -d '' theme; do
    install -Dm644 "$theme" \
      "${pkgdir}/usr/share/snappy-switcher/themes/$(basename "$(dirname "$theme")").ini"
  done < <(find "src/usr/share/argvus/app-profiles/config/snappy-switcher/themes" \
    -mindepth 2 -maxdepth 2 -type f -name theme.ini -print0)
  find "${pkgdir}/usr/share/argvus/app-profiles/sh" -type f -name '*.sh' -exec chmod 755 {} +

  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
