# Maintainer: William C. Canin
pkgname=argvus-app-profiles
pkgver=0.1.0
pkgrel=1
pkgdesc="Application profiles and launcher wrappers for the ARGVUS desktop."
arch=('any')
url="https://github.com/argvus/argvus-app-profiles"
license=('GPL-3.0-only')
depends=(
  'argvus-snappy-switcher'
  'argvus-session'
  'bottom'
  'btop'
  'foot'
  'jq'
  'kitty'
  'superfile'
  'yazi'
)
optdepends=(
  'argvus: argvus-about binary used by argvus --about in a full desktop install'
  'argvus-calendar: calendar app launched by argvus --calendar'
  'argvus-settings: settings app launched by argvus --settings'
  'argvus-storage: removable storage app launched by argvus --storage'
  'neovim: default terminal editor profile'
  'vivid: LS_COLORS generation in the shared terminal profile'
)
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=("SKIP")

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" PREFIX=/usr install
}
